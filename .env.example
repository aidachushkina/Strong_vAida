# Copy this file to `.env` and fill in your Supabase project values.
# Find them in the Supabase dashboard: Project Settings -> API.
#
# EXPO_PUBLIC_* variables are inlined into the client bundle by Expo.
# The anon key is designed to be public — Row Level Security protects your data.

EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
